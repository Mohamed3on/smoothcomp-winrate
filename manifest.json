{
  "manifest_version": 3,
  "name": "Mat Stats for Smoothcomp",
  "version": "1.105.0",
  "description": "Walkover-free win rates, athlete and academy leaderboards, head-to-heads, and every bracket ranked by its athletes' careers",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://smoothcomp.com/*",
        "https://*.smoothcomp.com/*",
        "https://ajptour.com/*"
      ],
      "js": [
        "en.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.smoothcomp.com/*/event/*/participants*",
        "https://smoothcomp.com/*/event/*/participants*",
        "https://ajptour.com/*/event/*/participants*",
        "https://*.smoothcomp.com/*/event/*/results*",
        "https://smoothcomp.com/*/event/*/results*",
        "https://ajptour.com/*/event/*/results*"
      ],
      "js": [
        "shared.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.smoothcomp.com/*/event/*/participants*",
        "https://smoothcomp.com/*/event/*/participants*",
        "https://ajptour.com/*/event/*/participants*"
      ],
      "js": [
        "rules.js",
        "site.js",
        "career-cache.js",
        "careers.js",
        "picks.js",
        "participants.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "css": [
        "participants.css"
      ]
    },
    {
      "matches": [
        "https://*.smoothcomp.com/*/event/*/results*",
        "https://smoothcomp.com/*/event/*/results*",
        "https://ajptour.com/*/event/*/results*"
      ],
      "js": [
        "rules.js",
        "site.js",
        "matches.js",
        "model.js",
        "results.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "css": [
        "results.css"
      ]
    },
    {
      "matches": [
        "https://smoothcomp.com/*/profile/*",
        "https://ajptour.com/*/profile/*"
      ],
      "js": [
        "shared.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://smoothcomp.com/*/profile/*",
        "https://ajptour.com/*/profile/*"
      ],
      "js": [
        "rules.js",
        "site.js",
        "profile-model.js",
        "profile.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "css": [
        "profile.css"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}

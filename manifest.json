{
  "manifest_version": 3,
  "name": "Smoothcomp Win Rate",
  "version": "1.4",
  "description": "Athlete leaders, medals, bracket sizes and match-based win rates on Smoothcomp results and participant lists",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.smoothcomp.com/*/event/*/participants*",
        "https://smoothcomp.com/*/event/*/participants*"
      ],
      "js": [
        "site.js",
        "participants.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.smoothcomp.com/*/event/*/results*",
        "https://smoothcomp.com/*/event/*/results*"
      ],
      "js": [
        "site.js",
        "matches.js",
        "model.js",
        "results.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle",
      "css": [
        "results.css"
      ]
    }
  ]
}
